<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!--
      Where the app finds MySQL. The default below matches a fresh XAMPP install (root, no password).
      For anything beyond a dev machine, create the limited app account with Data/create_app_user.sql
      and use it here instead, e.g.:
      Server=localhost;Port=3306;Database=hospital_system;Uid=hospital_app;Pwd=your-strong-password;
    -->
    <add name="HospitalSystem"
         connectionString="Server=localhost;Port=3306;Database=hospital_system;Uid=root;Pwd=;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
